# Jisr MCP Server — example configuration.
# Copy to .env and fill in. NEVER commit a filled-in copy.
# No value in this file is real, and none may ever be (spec FR-042).

# --- Connection (required) ---------------------------------------------------
# AWS-hosted organizations:    https://apis.jisr.net/api
# Locally hosted organizations: https://api.jisr.net.sa/api/
# If your Jisr web address ends in .jisr.net.sa you are locally hosted.
# Any other host is rejected at startup.
JISR_BASE_URL=https://apis.jisr.net/api

# Your organization slug, from your Jisr administrator.
JISR_SLUG=your-organization-slug

# Created in Jisr: Settings > Webhook & API Keys > API Keys > Add New API Key.
# The secret is displayed once only.
# Grant this key CORE HR READ permissions ONLY -- see the note below.
JISR_API_KEY=replace-me
JISR_API_SECRET=replace-me

# --- Authorization -----------------------------------------------------------
# One of: employee_self | manager | hr_operations | finance
#         integration_admin | auditor | platform_operator
JISR_ROLE_PROFILE=hr_operations

# Required ONLY for employee_self and manager, which are defined relative to a
# person. The server refuses to start without it for those profiles, rather than
# running with an empty reachable set that looks like "manages nobody".
# Must be the Jisr employee UUID, not the integer code.
# JISR_SUBJECT_EMPLOYEE_ID=00000000-0000-4000-8000-000000000001

# --- Finance surface (opt-in, off by default) --------------------------------
# The six financial tools do not exist unless this is 'enabled', even if the
# key above permits financial access (spec FR-023a).
#
# WHY A SEPARATE KEY: Jisr returns basic_salary, first_salary_pay_date and
# last_salary_pay_date inside the ORDINARY employee list whenever the connected
# key holds "Get Employee Financial Info". The server strips those fields for
# non-finance callers, but a narrow key means they never cross the network.
JISR_FINANCE_SURFACE=disabled
# JISR_FINANCE_API_KEY=replace-me
# JISR_FINANCE_API_SECRET=replace-me

# --- Operational -------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# Audit records are written as structured JSON to stderr and never to disk.
# Retention and forwarding are your responsibility (spec FR-038a).
